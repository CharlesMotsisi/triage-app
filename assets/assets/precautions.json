      "Refer to ENT."
    ],
    "Hypoglycemia": [
      "Check blood glucose immediately.",
      "Administer 15g fast-acting carbohydrates (juice/glucose).",
      "Recheck glucose in 15 minutes.",
      "Call Emergency if patient is unconscious."
    ],
    "Acne": [
      "Advise on gentle skin cleansing.",
      "Apply prescribed topical retinoids.",
      "Refer to Dermatology if severe."
    ],
    "Diabetes": [
      "Check blood glucose levels.",
      "Administer prescribed insulin/oral meds.",
      "Assess for diabetic foot ulcers.",
      "Refer to Endocrinology."
    ],
    "Impetigo": [
      "Clean affected area with warm water.",
      "Apply prescribed topical or oral antibiotics.",
      "Advise on covering sores to prevent spread."
    ],
