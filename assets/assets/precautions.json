{
  "precautions": {
    "Drug Reaction": [
      "Stop the medication immediately.",
      "Assess for anaphylaxis (airway, breathing).",
      "Administer antihistamines or epinephrine if severe.",
      "Refer to Emergency Department."
    ],
    "Malaria": [
      "Check vitals and temperature.",
      "Administer prescribed antimalarials.",
      "Encourage oral fluids.",
      "Refer to Infectious Diseases if severe."
    ],
    "Allergy": [
      "Administer antihistamine (e.g., Cetirizine).",
      "Apply calamine lotion to affected areas.",
      "Monitor for airway swelling.",
      "Discharge to home care if mild."
    ],
    "Hypothyroidism": [
      "Check thyroid function tests.",
      "Administer Levothyroxine as prescribed.",
      "Educate on daily medication adherence.",
      "Refer to Endocrine Clinic."
    ],
    "Psoriasis": [
      "Apply prescribed topical corticosteroids.",
      "Advise on gentle skin care.",
      "Refer to Dermatology for severe flare-ups."
    ],
    "GERD": [
